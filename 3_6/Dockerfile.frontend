FROM ubuntu:24.04 AS build
COPY --from=node:16-bullseye /usr/local/ /usr/local/
WORKDIR /usr/src/app
COPY code/example-frontend/ ./
ENV REACT_APP_BACKEND_URL=http://localhost:8080
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && npm ci && npm install -g serve@14.2.4 && npm run build \
    && rm -rf /var/lib/apt/lists/* /root/.npm node_modules src

FROM ubuntu:24.04
WORKDIR /usr/src/app
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /usr/local/lib/node_modules/serve /usr/local/lib/node_modules/serve
COPY --from=build /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib/x86_64-linux-gnu/libstdc++.so.6
COPY --from=build /usr/src/app/build ./build
USER 10001:10001
EXPOSE 5001
CMD ["node", "/usr/local/lib/node_modules/serve/build/main.js", "-s", "-l", "5001", "build"]
