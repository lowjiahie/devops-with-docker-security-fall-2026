FROM node:16-alpine AS build
WORKDIR /usr/src/app
COPY code/example-frontend/package*.json ./
RUN npm ci && npm install -g serve@14.2.4
COPY code/example-frontend/ ./
ENV REACT_APP_BACKEND_URL=http://localhost:8080
RUN npm run build

FROM node:16-alpine
WORKDIR /usr/src/app
COPY --from=build /usr/local/lib/node_modules/serve /usr/local/lib/node_modules/serve
COPY --from=build /usr/src/app/build ./build
USER node
EXPOSE 5001
CMD ["node", "/usr/local/lib/node_modules/serve/build/main.js", "-s", "-l", "5001", "build"]
